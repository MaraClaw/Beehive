{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noForEach": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "none",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.json",
      "!**/dist",
      "!.live-smoke-artifacts",
      "!.oss-corpus-artifacts",
      "!node_modules",
      "!.next",
      "!out",
      "!pnpm-lock.yaml",
      "!**/raw",
      "!**/wiki",
      "!**/state",
      "!**/agent",
      "!**/inbox",
      "!**/.omo",
      "!**/.claude",
      "!**/.cursor"
    ]
  }
}
