{
  "name": "@beehive/cli",
  "version": "3.21.0",
  "description": "Global CLI for Beehive.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beehive/beehive.git"
  },
  "homepage": "https://www.beehive.ai",
  "bugs": {
    "url": "https://github.com/beehive/beehive/issues"
  },
  "keywords": [
    "beehive",
    "llm",
    "knowledge-base",
    "markdown",
    "obsidian",
    "graph",
    "cli",
    "local-first"
  ],
  "license": "MIT",
  "bin": {
    "beehive": "dist/index.js",
    "vault": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/check-release-sync.mjs && node ../../scripts/check-published-manifests.mjs"
  },
  "dependencies": {
    "@beehive/engine": "3.21.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.9"
  }
}
