{
  "name": "@beehive/engine",
  "version": "3.21.0",
  "description": "Core engine for Beehive: ingest, compile, query, lint, and provider abstractions.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beehive/beehive.git"
  },
  "homepage": "https://www.beehive.ai",
  "bugs": {
    "url": "https://github.com/beehive/beehive/issues"
  },
  "keywords": [
    "beehive",
    "llm",
    "knowledge-base",
    "markdown",
    "obsidian",
    "graph",
    "search",
    "local-first"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "test -f ../viewer/dist/index.html || pnpm --dir ../viewer build; tsup src/index.ts --format esm --dts && tsup --config tsup.hooks.config.ts && node ../../scripts/copy-engine-grammar-assets.mjs && rm -rf dist/viewer && mkdir -p dist/viewer && cp -R ../viewer/dist/. dist/viewer/",
    "pretest": "tsup --config tsup.hooks.config.ts",
    "test": "BEEHIVE_ALLOW_PRIVATE_URLS=1 vitest run --testTimeout=30000",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/check-release-sync.mjs && node ../../scripts/check-published-manifests.mjs"
  },
  "dependencies": {
    "@asciidoctor/core": "^3.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@retorquere/bibtex-parser": "^10.0.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "chokidar": "^5.0.0",
    "compromise": "^14.15.1",
    "csv-parse": "^6.2.1",
    "fast-xml-parser": "^5.8.0",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.5",
    "ini": "^7.0.0",
    "istextorbinary": "^9.5.0",
    "jsdom": "^29.1.1",
    "mailparser": "^3.9.9",
    "mammoth": "^1.12.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mime-types": "^3.0.2",
    "neo4j-driver": "^6.1.0",
    "node-ical": "^0.26.1",
    "node-mbox": "^2.0.0",
    "node-sql-parser": "^5.4.0",
    "orga": "^4.7.1",
    "pdfjs-dist": "^6.0.227",
    "rtf-parser": "^1.3.3",
    "smol-toml": "^1.6.1",
    "subtitle": "^4.2.2",
    "tree-sitter-wasms": "^0.1.13",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "vis-network": "^10.1.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0",
    "youtube-transcript-plus": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/jsdom": "^28.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.9.3",
    "@types/turndown": "^5.0.6",
    "graphology-types": "^0.24.8",
    "tree-sitter-julia": "0.23.1",
    "tree-sitter-systemverilog": "0.3.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.8"
  }
}
